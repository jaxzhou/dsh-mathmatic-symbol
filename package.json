{
  "name": "@jaxzhou/dsh-mathmatic-symbol",
  "version": "0.1.2",
  "description": "DeepSeek Harness plugin: typeset LaTeX as font-free SVG/PNG images, draw geometry and function figures from a declarative spec, convert formulas or SVG into embeddable images, and assemble documents with those images inserted",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "media/demo.png",
    "examples",
    "scripts/render-example.mjs",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "latex",
    "mathjax",
    "math",
    "formula",
    "svg",
    "geometry",
    "figure",
    "png",
    "document",
    "markdown",
    "report",
    "latex-to-image"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaxzhou/dsh-mathmatic-symbol.git"
  },
  "homepage": "https://github.com/jaxzhou/dsh-mathmatic-symbol#readme",
  "bugs": {
    "url": "https://github.com/jaxzhou/dsh-mathmatic-symbol/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "mathjax-full": "^3.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.2"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
